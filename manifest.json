{
  "manifest_version": 2,
  "name": "Tab Finder",
  "version": "1.1",
  "description": "Quickly search and switch to any open tab with a keybind.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-finder@dotfiles",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "commands": {
    "open-tab-search": {
      "suggested_key": {
        "default": "Ctrl+P"
      },
      "description": "Open tab search overlay"
    }
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Tab Finder",
    "default_popup": "finder.html?popup"
  },
  "web_accessible_resources": [
    "finder.html"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  }
}
